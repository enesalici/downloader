# Giriş bilgileri (değiştirirseniz açık oturumlar kapanır, yeniden giriş gerekir)
APP_USER=vermilia
APP_PASSWORD=buraya-sifreyi-yazin

# Uygulamanın dışarıya açılacağı port (HTTPS profili kullanıyorsanız dokunmayın)
APP_PORT=8000

# --- Sadece alan adıyla HTTPS kullanıyorsanız ---
# DOMAIN=video.ornekalanadi.com
# TRUST_PROXY=1
# COOKIE_SECURE=1

# --- İnce ayarlar ---
# İndirilen dosya sunucuda kaç dakika tutulsun (linkler kalıcıdır, bu sadece video dosyası için)
FILE_TTL_MINUTES=30
# Aynı anda en fazla kaç indirme
MAX_PARALLEL_DOWNLOADS=2
# En yüksek çözünürlük (1080 telefona fazlasıyla yeter)
MAX_HEIGHT=1080
